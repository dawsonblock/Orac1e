.venv/
.workspace-cache/
workspace/worktrees/*
!workspace/worktrees/.gitkeep
workspace/artifacts/*
!workspace/artifacts/.gitkeep
workspace/runs/*
!workspace/runs/.gitkeep
*.log
.DS_Store

# Python bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment and build artifacts
.env
dist/
build/
*.sqlite
*.db
*.tar.gz

# Prevent editable-install artifacts inside vendored third_party from
# polluting every Python environment on the machine via sys.path scanning.
third_party/**/*.egg-info/
third_party/**/*.dist-info/
third_party/**/__pycache__/
requirements.lock.txt
