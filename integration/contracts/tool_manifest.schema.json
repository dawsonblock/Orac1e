{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "api_version",
    "kind",
    "capabilities",
    "base_url",
    "health_path",
    "invoke_path",
    "risk_level",
    "timeouts",
    "concurrency",
    "features"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["worker", "retrieval", "validator", "action"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base_url": {
      "type": "string",
      "minLength": 1
    },
    "health_path": {
      "type": "string",
      "minLength": 1
    },
    "invoke_path": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "repo_languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health_ms", "invoke_ms"],
      "properties": {
        "health_ms": { "type": "integer", "minimum": 100 },
        "invoke_ms": { "type": "integer", "minimum": 1000 }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_global", "max_per_repo"],
      "properties": {
        "max_global": { "type": "integer", "minimum": 1 },
        "max_per_repo": { "type": "integer", "minimum": 1 }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supports_diff",
        "supports_streaming",
        "supports_cancellation"
      ],
      "properties": {
        "supports_diff": { "type": "boolean" },
        "supports_streaming": { "type": "boolean" },
        "supports_cancellation": { "type": "boolean" }
      }
    }
  }
}
