{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolResponseEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "status",
    "tool_id",
    "capability",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}