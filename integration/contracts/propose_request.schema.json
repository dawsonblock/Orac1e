{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "repo_name",
    "repo_path",
    "task",
    "mode",
    "context",
    "constraints"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "repo_name": {
      "type": "string"
    },
    "repo_path": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "interactive",
        "autonomous"
      ]
    },
    "context": {
      "type": "object"
    },
    "constraints": {
      "type": "object"
    }
  }
}